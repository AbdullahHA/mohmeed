{
  "expo": {
    "name": "يلا نسافر",
    "slug": "yalla-nsafer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yallansafer",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك عشان نقترح أماكن قريبة، ونحسب وقت المشوار وأوقات الصلاة.",
        "NSFaceIDUsageDescription": "نستخدم Face ID عشان نحمي مستنداتك الخاصة.",
        "NSPhotoLibraryUsageDescription": "عشان تضيف صور لمنشوراتك ومستنداتك.",
        "NSCameraUsageDescription": "عشان تصوّر تذاكرك وحجوزاتك.",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#164743",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.yallansafer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "يلا نسافر",
      "lang": "ar",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#164743",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#164743"
          }
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك عشان نقترح أماكن قريبة، ونحسب وقت المشوار وأوقات الصلاة."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "نستخدم Face ID عشان نحمي مستنداتك الخاصة."
        }
      ],
      "expo-notifications",
      "expo-web-browser"
    ],
    "scheme": "yallansafer",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "44a23fa1-c44c-42b0-8320-92967af2907e"
      }
    },
    "owner": "abdullbmo"
  }
}